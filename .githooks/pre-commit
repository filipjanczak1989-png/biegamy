#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# PRE-COMMIT — PRZYPOMNIENIE, NIE ZAMEK.
#
# ⚠️ Ten hook da się ominąć jedną flagą (`git commit --no-verify`) i NIE
#    PRZEŻYWA `git clone`, bo katalog `.git/hooks` nie jest wersjonowany.
#    GitHub.com nie ma hooków po stronie serwera. Zamek jest w CI:
#    .github/workflows/bramka.yml
#
#    Ma to sens mimo to: łapie pomyłkę zanim wyjdzie z maszyny, czyli wtedy,
#    gdy naprawa kosztuje `git reset`, a nie rewert na produkcji.
#
# INSTALACJA (raz na klon — patrz CLAUDE.md):
#     git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────────────────────────
set -e

KORZEN=$(git rev-parse --show-toplevel)
cd "$KORZEN"

if ! command -v node >/dev/null 2>&1; then
  echo "  hook: brak node — pomijam bramki (CI i tak sprawdzi)."
  exit 0
fi

status=0

# ⚠️ SAMOKONTROLA PRZED SPRAWDZENIEM. Bramka, która przechodzi dlatego, że
#    wywróciła się w środku, jest gorsza niż jej brak — udaje, że sprawdziła.
if ! node tools/bramka-reguly.js --samokontrola >/dev/null 2>&1; then
  echo "  ⚠ SAMOKONTROLA bramki reguł PADŁA — bramce nie można ufać."
  node tools/bramka-reguly.js --samokontrola || true
  status=1
fi

if ! node tools/bramka-commit.js --samokontrola >/dev/null 2>&1; then
  echo "  ⚠ SAMOKONTROLA bramki commita PADŁA — bramce nie można ufać."
  node tools/bramka-commit.js --samokontrola || true
  status=1
fi

node tools/bramka-reguly.js || status=1
# ⚠️ --przed-wiadomoscia: tu NIE MA jeszcze treści commita, więc miękkie blokady
#    (migracja, polityka RLS, DROP) tylko się WYPISUJĄ jako „czeka na trailer".
#    Rozstrzyga hook commit-msg (obok), który dostaje wiadomość i szuka w niej
#    `Bramka-zatwierdzona: <powód>`. Twarde blokady (sekrety, GRANT dla anon)
#    zatrzymują już tutaj — na nie trailer nie działa.
node tools/bramka-commit.js --przed-wiadomoscia || status=1

if command -v python >/dev/null 2>&1; then
  python tools/sprawdz-run-types.py  || status=1
  python tools/sprawdz-spol-stale.py || status=1
fi

if [ "$status" -ne 0 ]; then
  cat <<'KONIEC'

  ────────────────────────────────────────────────────────────────
  ⚠ BRAMKA ZATRZYMAŁA COMMIT — blokada TWARDA.

  Sekret w treści, klucz obcej usługi, GRANT dla `anon`, wyłączenie RLS:
  tego nie zatwierdza żaden trailer i CI też to zaczerwieni. Popraw diff.

  (Miękkie sprawy — migracja, polityka RLS, DROP — NIE zatrzymują tutaj:
   są wypisane wyżej jako „czeka na trailer" i rozstrzyga je hook
   commit-msg. Przechodzą z wierszem w TREŚCI commita:
       Bramka-zatwierdzona: <powód, co najmniej 10 znaków>
   Powód zostaje w historii gita. `--no-verify` od 6.10.2026 nie jest
   drogą — jest odruchem, który omija także blokady twarde.)
  ────────────────────────────────────────────────────────────────

KONIEC
fi

exit "$status"
