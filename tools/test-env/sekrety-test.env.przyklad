# WZÓR sekretów Edge Functions projektu TESTOWEGO (08.10.2026). Skopiuj POZA repo, uzupełnij, podaj w
# SEKRETY=… dla tools/test-env/deploy-ef.sh. Puste = funkcja działa bez tej integracji albo zwraca błąd.
# Lista = wszystkie Deno.env.get z supabase/functions (zmierzone grepem 8.10).

# Klucz secret projektu TESTOWEGO (Settings → API) — 10 funkcji (intervals-*, generate-*, delete-account…)
SB_SECRET_KEY=

# AI (8 funkcji: generate-*, food-recognize, food-micronutrients, food-search-usda, ocr-training-screen).
# OSOBNY klucz z twardym limitem wydatków (np. 5 USD/mies.) albo PUSTO = AI na teście wyłączone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Push: wartość z ~/.cache/biegamy-test/<data>/sekret-push-hook.env (ta sama co vault push_hook_secret TESTU)
PUSH_HOOK_SECRET=
# VAPID: push na teście NIE działa w fazie 1 — publiczny klucz VAPID jest zaszyty w sb.js i sw.js (prod).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# intervals.icu: ta sama aplikacja client_id 533 z DOPISANYM redirect URI hosta testowego.
# Webhook aplikacji ma jeden adres (prod) — na test NIE trafi; synchronizacja ręczna (intervals-sync) działa.
INTERVALS_CLIENT_SECRET=
INTERVALS_WEBHOOK_SECRET=

# Maile: WYŁĄCZONE na teście (pusto) — send-report-email nie wyśle nic.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUBLIC_APP_URL=

# Darmowe zewnętrzne API — można ten sam klucz co prod albo pusto
GIPHY_API_KEY=
USDA_API_KEY=
UNSPLASH_ACCESS_KEY=
